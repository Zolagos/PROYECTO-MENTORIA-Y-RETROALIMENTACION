# ==========================================
# SERVER
# ==========================================

PORT=3000
NODE_ENV=development


# ==========================================
# DATABASE
# ==========================================

# Local/docker-compose setup uses the discrete vars below.
DB_PORT =
DB_PORT_MAP=

DB_NAME=

DB_USER=

DB_PASSWORD=

# Managed Postgres (e.g. Railway) provides a single connection string instead.
# When set, it takes priority over the discrete DB_* vars above.
DATABASE_URL=


# ==========================================
# AUTH
# ==========================================

JWT_SECRET=
JWT_EXPIRES_IN=


# ==========================================
# CORS
# ==========================================

CORS_ORIGIN=http://localhost:5173

# ==========================================
# FRONTEND (build-time, apps/frontend)
# ==========================================

# Public URL of the backend API, baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:3000/api